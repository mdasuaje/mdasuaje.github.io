# =============================================================================
# BULLETPROOF .gitignore — mdasuaje.github.io
# STRATEGY: DENY BY DEFAULT, EXPLICIT ALLOWLIST ONLY
# Guarantees: Zero leaks, zero unauthorized publishes, defense-in-depth
# =============================================================================

# -----------------------------------------------------------------------------
# DENY EVERYTHING BY DEFAULT (root level)
# -----------------------------------------------------------------------------
/*

# -----------------------------------------------------------------------------
# EXPLICIT ALLOWLIST — Only these paths are tracked/published
# -----------------------------------------------------------------------------
!/.gitignore
!/index.html
!/README.md
!/fonts/
!/fonts/**
!/.well-known/
!/.well-known/**
!/.github/
!/.github/**
!/.github/workflows/
!/.github/workflows/**

# -----------------------------------------------------------------------------
# BLOCK ALL PRIVATE / SESSION / RUNTIME ARTIFACTS (defense in depth)
# Even if allowlist fails, these patterns catch them
# -----------------------------------------------------------------------------
# Private profiles (any naming convention)
*privado*
*private*
*Privado*
*Private*

# Session artifacts
sesion-activa*
session-*
*.session.*

# Pi / Agent runtime state
/.pi/
/.atl/
/.gentle-ai/

# IDE / Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Environment / Secrets / Credentials (absolute block)
.env
.env.*
*.env
*.key
*.pem
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
*secret*
*token*
*credential*
.aws/
.terraform/

# Build / Dependency artifacts
node_modules/
dist/
build/
*.log
*.cache
coverage/

# Backup / Archive
*.bak
*.backup
*.zip
*.tar.gz
*.7z

# Local docs / drafts
*.local.md
*.draft.md
docs/local/
docs/drafts/

# =============================================================================
# END — This file uses DENY-BY-DEFAULT + EXPLICIT ALLOWLIST
# Any file not explicitly allowed above CANNOT be committed accidentally
# =============================================================================